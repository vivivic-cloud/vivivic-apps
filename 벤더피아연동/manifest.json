{
  "manifest_version": 3,
  "name": "벤더피아 보기",
  "version": "0.30.0",
  "description": "벤더피아 화면을 필요한 것만 깔끔하게 보여줍니다.",
  "content_scripts": [
    {
      "matches": [
        "https://vendorpia.com/*",
        "https://www.vendorpia.com/*"
      ],
      "js": [
        "vp-data.js",
        "login.js"
      ],
      "css": [
        "login.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://vendorpia.com/index.aspx*",
        "https://www.vendorpia.com/index.aspx*"
      ],
      "js": [
        "menu.js"
      ],
      "css": [
        "menu.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://vendorpia.com/System/Delivery/firmDvList.aspx*",
        "https://www.vendorpia.com/System/Delivery/firmDvList.aspx*"
      ],
      "js": [
        "search.js"
      ],
      "css": [
        "search.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://vendorpia.com/System/Master/goods.aspx*",
        "https://www.vendorpia.com/System/Master/goods.aspx*",
        "https://vendorpia.com/System/Master/salesGoods.aspx*",
        "https://www.vendorpia.com/System/Master/salesGoods.aspx*",
        "https://vendorpia.com/System/Stock/StockList.aspx*",
        "https://www.vendorpia.com/System/Stock/StockList.aspx*"
      ],
      "js": [
        "johon.js",
        "amt-draw.js",
        "goods.js"
      ],
      "css": [
        "goods.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://vivivic-cloud.github.io/vivivic-apps/*"
      ],
      "js": [
        "johon-read.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vivivic-cloud.github.io/vivivic-apps/*"
      ],
      "js": [
        "johon-save.js",
        "깔렸다표시.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage"
  ]
}
