{
  "manifest_version": 3,
  "name": "벤더피아 보기",
  "version": "0.34.4",
  "description": "벤더피아 화면을 필요한 것만 깔끔하게 보여줍니다.",
  "content_scripts": [
    {
      "matches": [
        "https://vendorpia.com/*",
        "https://www.vendorpia.com/*"
      ],
      "js": [
        "불러오기.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://vendorpia.com/*",
        "https://www.vendorpia.com/*"
      ],
      "js": [
        "짚개.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true
    },
    {
      "matches": [
        "https://vivivic-cloud.github.io/vivivic-apps/*"
      ],
      "js": [
        "johon-read.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vivivic-cloud.github.io/vivivic-apps/*"
      ],
      "js": [
        "johon-save.js",
        "깔렸다표시.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "저장다리.js",
        "vp-data.js",
        "login.js",
        "menu.js",
        "search.js",
        "johon.js",
        "amt-draw.js",
        "goods.js",
        "짚개.js",
        "login.css",
        "menu.css",
        "search.css",
        "goods.css",
        "손잡이.js"
      ],
      "matches": [
        "https://vendorpia.com/*",
        "https://www.vendorpia.com/*"
      ]
    }
  ]
}
