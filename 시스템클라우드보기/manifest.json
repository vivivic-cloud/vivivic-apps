{
  "manifest_version": 3,
  "name": "시스템클라우드 보기",
  "version": "0.8.3",
  "description": "SystemCloud(inghometest.ksystemace.com) 화면을 필요한 것만 깔끔하게 보여줍니다.",
  "content_scripts": [
    {
      "matches": [
        "https://inghometest.ksystemace.com/*"
      ],
      "js": [
        "login.js"
      ],
      "css": [
        "login.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://inghometest.ksystemace.com/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "guide.js"
      ],
      "css": [
        "guide.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://inghometest.ksystemace.com/*"
      ],
      "js": [
        "sc-read.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "templates/*.xlsx"
      ],
      "matches": [
        "https://inghometest.ksystemace.com/*"
      ]
    }
  ]
}