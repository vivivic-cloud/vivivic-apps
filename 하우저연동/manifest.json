{
  "manifest_version": 3,
  "name": "하우저 보기",
  "version": "0.1.0",
  "description": "하우저(howser.co.kr) 재고현황을 읽어 우리 표로 보여 준다. 읽기만 하고 저장·전송하지 않는다.",
  "content_scripts": [
    {
      "matches": ["https://www.howser.co.kr/storage/inventory/list*"],
      "js": ["inventory.js"],
      "css": ["inventory.css"],
      "run_at": "document_idle"
    }
  ]
}
