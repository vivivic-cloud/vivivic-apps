{
  "manifest_version": 3,
  "name": "하우저 보기",
  "version": "0.2.1",
  "description": "하우저(howser.co.kr) 화면을 필요한 것만 깔끔한 표로 보여 줍니다. 읽기만 하고 저장·전송하지 않습니다.",
  "content_scripts": [
    {
      "matches": ["https://www.howser.co.kr/*", "https://howser.co.kr/*"],
      "js": ["불러오기.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://vivivic-cloud.github.io/vivivic-apps/*"],
      "js": ["깔렸다표시.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting"],
  "host_permissions": [
    "https://www.howser.co.kr/*",
    "https://howser.co.kr/*",
    "https://vivivic-cloud.github.io/*"
  ],
  "background": { "service_worker": "bg.js" }
}
